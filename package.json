{
  "name": "bridgecast",
  "version": "2.0.0",
  "description": "Bridgecast: slide deck output to a second display (HDMI)",
  "main": "./out/main/index.js",
  "author": "Bridgecast",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "test": "vitest run",
    "dev": "electron-vite dev -- --ozone-platform=x11",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:icons": "node scripts/build-icons.mjs",
    "build:bridge": "bash scripts/build-ppt-bridge.sh",
    "build:web-bridge": "bash scripts/build-web-bridge.sh",
    "build:web-bridge:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-web-bridge.ps1",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test:e2e": "electron-vite build && node e2e/smoke.mjs",
    "test:e2e:update": "electron-vite build && node e2e/update.mjs",
    "test:e2e:network": "electron-vite build && node e2e/network.mjs",
    "test:e2e:media": "electron-vite build && node e2e/media.mjs",
    "test:e2e:media-omt": "electron-vite build && node e2e/media-omt.mjs",
    "test:e2e:web": "electron-vite build && node e2e/web.mjs",
    "test:e2e:native": "electron-vite build && node e2e/native.mjs",
    "test:e2e:web-bridge": "electron-vite build && node e2e/web-bridge.mjs",
    "test:e2e:web-bridge:real": "electron-vite build && node e2e/web-bridge-real.mjs",
    "test:e2e:settings": "electron-vite build && node e2e/settings.mjs",
    "test:e2e:layout": "electron-vite build && node e2e/layout.mjs",
    "test:e2e:all": "electron-vite build && node e2e/smoke.mjs && node e2e/network.mjs && node e2e/web.mjs && node e2e/media.mjs && node e2e/web-bridge.mjs && node e2e/native.mjs && node e2e/settings.mjs && node e2e/layout.mjs && node e2e/tour.mjs && node e2e/update.mjs && node e2e/new-event.mjs",
    "test:e2e:native:win": "electron-vite build && node e2e/native-real.mjs",
    "test:packaged": "node e2e/packaged.mjs",
    "test:e2e:tour": "electron-vite build && node e2e/tour.mjs",
    "release": "node scripts/release.mjs",
    "release:win": "node scripts/release.mjs --win --publish",
    "release:linux": "node scripts/release.mjs --linux --publish",
    "test:e2e:new-event": "electron-vite build && node e2e/new-event.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11",
    "koffi": "3.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
